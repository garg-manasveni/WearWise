PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/wearwise
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h
CLIENT_ORIGIN=http://localhost:5173
# Add comma-separated extra allowed frontend origins only if you use them.
CLIENT_ORIGINS=
# Optional comma-separated DNS servers, e.g. 8.8.8.8,8.8.4.4
DNS_SERVERS=
UPLOAD_DIR=uploads
# Optional. Enables personalized avatar generation; keep this key private and server-side.
OPENAI_API_KEY=
# Optional image-generation model override. Defaults to gpt-image-2.5-sunburst.
OPENAI_AVATAR_MODEL=
